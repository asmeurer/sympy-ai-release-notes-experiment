+def test_logaddexp_evalf_precision():
+    assert logaddexp(x, y).evalf() == log(exp(x) + exp(y))
+    cases = [(logaddexp(2, 3), log(exp(2) + exp(3))),
+             (logaddexp2(2, 3), log(12)/log(2))]
+    for expr, expected in cases:
