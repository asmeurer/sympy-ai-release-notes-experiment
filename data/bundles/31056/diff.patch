+    def _eval_derivative(self, x):
+        from .matadd import MatAdd
+        args = self.args
+        terms = []
+        for i, arg in enumerate(args):
+            d_arg = arg.diff(x)
+            term = MatMul(*(args[:i] + (d_arg,) + args[i + 1:])).doit()
+            if not term.is_ZeroMatrix:
+                terms.append(term)
+        if not terms:
+            return ZeroMatrix(*self.shape)
+        return MatAdd(*terms).doit()
