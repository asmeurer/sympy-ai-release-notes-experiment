+def leading_sign(*xs: Expr) -> Expr:
+    """The sign of the first nonzero argument, and 1 if there is none."""
+    result: Expr = S.One
+    for x in reversed(xs):
+        s = sign(x)
+        # Keep the running value when x is zero, replace it by sign(x) otherwise.
+        result = s + (1 - s**2) * result
+    return result
+
+
