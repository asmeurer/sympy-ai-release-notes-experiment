+class _ExactComplex:
+    __slots__ = ('a', 'b', 'q')
+
+    def __init__(self):
+        # (a + i*b)/q
+        self.q = 1
+        self.a = 1
+        self.b = 0
+
+    def __imul__(self, ri):
+        r, i = ri
+        c = r.p*i.q
+        d = i.p*r.q
+        s = r.q*i.q
+        a, b, q = self.a, self.b, self.q
+
+        real = a*c - b*d
+        imag = a*d + b*c
+        denom = q*s
+
+        g = math.gcd(real, imag, denom)
+        self.a = real // g
+        self.b = imag // g
+        self.q = denom // g
+        return self
+
+    def as_rationals(self):
+        from sympy.core.numbers import Rational
+        return Rational(self.a, self.q), Rational(self.b, self.q)
+
+
