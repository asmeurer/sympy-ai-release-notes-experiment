+def test_bsgs_direct_product_zero_rank():
+    zero = get_symmetric_group_sgs(0)
+    assert bsgs_direct_product(*zero, *zero) == zero
+    for antisym in (False, True):
+        group = get_symmetric_group_sgs(2, antisym)
